{
  "name": "motion-lab-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop wrapper for the Movement Sensor Lab camera station",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.limboai.motionlab",
    "productName": "Motion Lab",
    "files": [
      "main.js",
      "local-server.js",
      "app/**/*",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": "zip",
      "icon": "build/icon.icns",
      "category": "public.app-category.healthcare-fitness"
    }
  }
}
